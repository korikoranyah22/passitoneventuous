<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CursoAgentes.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CursoAgentes.Infrastructure\CursoAgentes.Infrastructure.csproj" />
    <ProjectReference Include="..\CursoAgentes.MiyuAgents\CursoAgentes.MiyuAgents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host genérico: configuración + DI + hosted services (los subscriptions de Eventuous son hosted services). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
