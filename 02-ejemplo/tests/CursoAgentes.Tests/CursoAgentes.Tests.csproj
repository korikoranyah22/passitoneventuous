<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <MiyuExamplesAvailable Condition="Exists('..\..\..\..\angelnairav2_public\Packages\MiyuAgents\examples\incident-response\IncidentResponseExample.csproj')">true</MiyuExamplesAvailable>
    <MiyuExamplesAvailable Condition="'$(MiyuExamplesAvailable)' == ''">false</MiyuExamplesAvailable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Eventuous (para IEventStore y los command services que testeamos). -->
    <PackageReference Include="Eventuous" Version="0.16.3" />
    <PackageReference Include="Eventuous.Application" Version="0.16.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CursoAgentes.Domain/CursoAgentes.Domain.csproj" />
    <ProjectReference Include="../../src/CursoAgentes.Api/CursoAgentes.Api.csproj" />
    <ProjectReference Include="../../src/CursoAgentes.Engine/CursoAgentes.Engine.csproj" />
    <ProjectReference Include="../../src/CursoAgentes.Infrastructure/CursoAgentes.Infrastructure.csproj" />
    <ProjectReference Include="../../src/CursoAgentes.MiyuAgents/CursoAgentes.MiyuAgents.csproj"
                      Condition="'$(MiyuExamplesAvailable)' == 'true'" />
  </ItemGroup>

  <!-- Los ejemplos Miyu viven fuera del curso. Si esa checkout no los trae,
       la suite core sigue siendo ejecutable y sólo se omite el puente. -->
  <ItemGroup Condition="'$(MiyuExamplesAvailable)' != 'true'">
    <Compile Remove="MiyuEventuousBridgeTests.cs" />
  </ItemGroup>

</Project>
